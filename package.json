{
  "name": "dewmap",
  "version": "0.3.0",
  "description": "Maps, trains and the real world — a client-side navigation and exploration app.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:scripts": "node --test scripts/history/*.test.mjs",
