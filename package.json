    "@turf/helpers": "^7.3.5",
    "@turf/length": "^7.3.5",
    "maplibre-gl": "^5.23.0",
    "next": "16.2.4",
    "pbf": "^4.0.1",
    "pmtiles": "^4.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "h3-js": "^4.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
